{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-native",
    "baseUrl": ".",
    "paths": {
      "@dusmint/ui": ["./src/ui/index"],
      "@dusmint/ui/*": ["./src/ui/*"],
      "@dusmint/api-client": ["./src/api-client/index"],
      "@dusmint/api-client/*": ["./src/api-client/*"],
      "@dusmint/i18n": ["./src/i18n/index"],
      "@dusmint/i18n/*": ["./src/i18n/*"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*", "App.tsx", "index.js"]
}
